# Copy to .env (non-secrets) and .env.secrets (token). Never commit either.
# On the VPS the deploy workflow writes .env and keeps .env.secrets.

WA_API_HOST=127.0.0.1
WA_API_PORT=8788
WA_DATA_DIR=./data
WA_SENDING_PAUSED=false

# Comma-separated bearer tokens. Put this in .env.secrets on the server.
# WA_ADAPTER_API_TOKENS=
